# ---------------------------------------------------------------------------
# Studio 808 site — environment variables
# Copy to .env for local dev. In production, set these in the Vercel project.
# Anything prefixed VITE_ is exposed to the browser; everything else is
# server-only (Vercel serverless functions in /api).
# ---------------------------------------------------------------------------

# --- Public (browser) — Supabase anon client (src/lib/supabase.ts) ---
VITE_SUPABASE_URL=https://eesphuovfbwfiqqldqtu.supabase.co
VITE_SUPABASE_ANON_KEY=your-lumentry-anon-key

# --- Server-only — Supabase auth (api/signin.js) ---
SUPABASE_URL=https://eesphuovfbwfiqqldqtu.supabase.co
SUPABASE_ANON_KEY=your-lumentry-anon-key

# --- Server-only — Residency application intake (api/residency-apply.js) ---
# service_role key bypasses RLS. NEVER expose this to the browser / prefix VITE_.
SUPABASE_SERVICE_ROLE_KEY=your-lumentry-service-role-key
RESEND_API_KEY=your-resend-api-key
# Optional overrides (defaults shown):
# RESIDENCY_NOTIFY_TO=paul@studio-808.com
# RESIDENCY_NOTIFY_FROM=Studio 808 Residency <residency@send.studio-808.com>

# --- Server-only — Assistant Videographer application intake (api/videographer-apply.js) ---
# Reuses SUPABASE_SERVICE_ROLE_KEY + RESEND_API_KEY above. CVs are stored in the
# private `videographer-cvs` storage bucket (created by the migration).
# Optional overrides (defaults shown):
# VIDEOGRAPHER_NOTIFY_TO=paul@studio-808.com
# VIDEOGRAPHER_NOTIFY_FROM=Studio 808 <videographer@send.studio-808.com>

# --- Server-only — Chat assistant (api/chat.js) ---
ANTHROPIC_API_KEY=your-anthropic-api-key
